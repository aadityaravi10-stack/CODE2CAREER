APP_ENV=development
# auto uses Gemini first, then Groq, then OpenRouter when their keys are present.
AI_MODE=auto
DATABASE_URL=sqlite:///./gd_arena.sqlite3

# Future real providers can read these. Leave blank for demo/mock mode.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
STT_PROVIDER_KEY=
EDGE_TTS_VOICE=en-IN-NeerjaNeural
